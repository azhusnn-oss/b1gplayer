<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.B1gPlayer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- The player runs edge to edge with no system decoration of its own. -->
    <style name="Theme.B1gPlayer.Player" parent="Theme.B1gPlayer">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
